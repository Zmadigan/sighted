# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it holds your secrets.

# Neon Postgres connection string (Neon dashboard → Connect → copy the "pooled" URL)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Random secret used to sign login sessions. Generate one with:
#   npx @better-auth/cli secret      (or any 32+ character random string)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# The URL your app runs at. Locally: http://localhost:3000
# On Vercel: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Claude API key from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Stripe secret key (Dashboard → Developers → API keys). Use the sk_test_ key while testing.
STRIPE_SECRET_KEY="sk_test_..."

# Stripe webhook signing secret (only needed on the live site; set up for you on Vercel)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe LIVE secret key, only used by `node scripts/setup-stripe.mjs <site> --live`
# (the app itself always reads STRIPE_SECRET_KEY)
STRIPE_LIVE_SECRET_KEY="sk_live_..."
